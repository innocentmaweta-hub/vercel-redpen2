{
    "buildCommand": "vite build",
    "outputDirectory": "dist",
    "devCommand": "vite --port=5000 --host=0.0.0.0",
    "functions": {
        "api/server-wordpress.js": {
            "runtime": "nodejs18.x"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/server-wordpress.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "env": [
        "WORDPRESS_SITE_URL",
        "WORDPRESS_API_URL",
        "WORDPRESS_USERNAME",
        "WORDPRESS_PASSWORD",
        "JWT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GEMINI_API_KEY",
        "OPENAI_API_KEY"
    ]
}
